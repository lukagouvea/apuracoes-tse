{
  "name": "INF425 - Projeção eleitoral (Blackwell)",
  "dockerComposeFile": "../compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"],
      "settings": {"python.defaultInterpreterPath": "/opt/venv/bin/python"}
    }
  }
}
