FROM python:3.11.15-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
COPY requirements-reproduce.txt requirements-torch-cpu.txt /tmp/requirements/
RUN pip install --no-cache-dir -r /tmp/requirements/requirements-reproduce.txt \
    -r /tmp/requirements/requirements-torch-cpu.txt
WORKDIR /workspace
